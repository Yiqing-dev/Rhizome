{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "mainBinaryName": "Rhizome",
  "version": "0.1.6",
  "identifier": "dev.rhizome.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rhizome",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 480,
        "url": "index.html",
        "center": true,
        "dragDropEnabled": false,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rhizome",
    "copyright": "Copyright 2026 Yiqing Wang and the Rhizome contributors. Apache-2.0.",
    "category": "Education",
    "shortDescription": "Personal literature asset graph",
    "longDescription": "Rhizome splits papers you have read and discussed into reusable datasets, methods, ideas and claims, links them, and brings them back when they are useful again.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/server/": "server/",
      "windows/rhz.cmd": "rhz.cmd",
      "../../NOTICE": "NOTICE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}

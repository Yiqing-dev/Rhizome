{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "version": "0.1.0",
  "identifier": "dev.rhizome.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Rhizome", "width": 1280, "height": 860, "url": "index.html" }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "externalBin": ["binaries/rhizome-server"],
    "licenseFile": "../../LICENSE",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "wix": { "language": ["en-US", "zh-CN"] } }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}

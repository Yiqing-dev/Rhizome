{
  "$defs": {
    "Assets": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "items": {
            "$ref": "#/$defs/Dataset"
          },
          "title": "Datasets",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/Method"
          },
          "title": "Methods",
          "type": "array"
        },
        "ideas": {
          "items": {
            "$ref": "#/$defs/Idea"
          },
          "title": "Ideas",
          "type": "array"
        }
      },
      "title": "Assets",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "causal",
            "correlational",
            "speculative"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "evidence": {
          "description": "Location in the paper, e.g. 'Fig. 3B' (required)",
          "title": "Evidence",
          "type": "string"
        },
        "boundary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "logic_jump": {
          "default": false,
          "title": "Logic Jump",
          "type": "boolean"
        },
        "stance": {
          "default": "supports",
          "enum": [
            "supports",
            "contradicts"
          ],
          "title": "Stance",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_type",
        "evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "accession": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accession"
        },
        "database": {
          "anyOf": [
            {
              "enum": [
                "GEO",
                "SRA",
                "ENA",
                "GSA",
                "CNGB",
                "ArrayExpress",
                "Zenodo",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "organism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "tissue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tissue"
        },
        "modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality"
        },
        "scale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "public": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public"
        },
        "role": {
          "default": "uses",
          "enum": [
            "uses",
            "produces"
          ],
          "title": "Role",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "title": "Dataset",
      "type": "object"
    },
    "Idea": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "transfer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transfer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "default": "model",
          "enum": [
            "model",
            "user"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Idea",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "severity": {
          "enum": [
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        }
      },
      "required": [
        "severity",
        "text"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo"
        },
        "biotools": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biotools"
        },
        "role": {
          "default": "uses",
          "enum": [
            "proposes",
            "uses",
            "evaluates"
          ],
          "title": "Role",
          "type": "string"
        },
        "io": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Io"
        },
        "maintained": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maintained"
        },
        "modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality"
        },
        "extends": {
          "items": {
            "type": "string"
          },
          "title": "Extends",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "name"
      ],
      "title": "Method",
      "type": "object"
    },
    "Paper": {
      "additionalProperties": false,
      "properties": {
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DOI without the https://doi.org/ prefix",
          "title": "Doi"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1600,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "type": {
          "items": {
            "enum": [
              "research",
              "tool",
              "resource",
              "benchmark",
              "review",
              "protocol"
            ],
            "type": "string"
          },
          "title": "Type",
          "type": "array"
        },
        "organisms": {
          "items": {
            "type": "string"
          },
          "title": "Organisms",
          "type": "array"
        },
        "modalities": {
          "items": {
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title"
      ],
      "title": "Paper",
      "type": "object"
    },
    "ReviewCard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "q": {
          "title": "Q",
          "type": "string"
        },
        "a": {
          "title": "A",
          "type": "string"
        },
        "about": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "id of the item in this file the card is about",
          "title": "About"
        }
      },
      "required": [
        "q",
        "a"
      ],
      "title": "ReviewCard",
      "type": "object"
    },
    "TopicRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "relation": {
          "enum": [
            "about",
            "applicable_to"
          ],
          "title": "Relation",
          "type": "string"
        },
        "aliases": {
          "description": "Other names for the same topic (the Chinese name, an acronym), so it is matched to an existing topic instead of becoming a second one",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "name",
        "relation"
      ],
      "title": "TopicRef",
      "type": "object"
    },
    "Transfer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cross-species",
            "cross-modality",
            "cross-problem"
          ],
          "title": "Type",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "barrier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barrier"
        }
      },
      "required": [
        "type"
      ],
      "title": "Transfer",
      "type": "object"
    },
    "UserInsight": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local id, unique within this file (e.g. c1, m2); user_insights.links_to and review_cards.about refer to it",
          "title": "Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "links_to": {
          "description": "ids of items in this file",
          "items": {
            "type": "string"
          },
          "title": "Links To",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "UserInsight",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rxf_version": {
      "const": 1,
      "title": "Rxf Version",
      "type": "integer"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Id of this export, assigned by the exporting chat",
      "title": "Id"
    },
    "exported_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the export was written (ISO 8601)",
      "title": "Exported At"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Main language of the free-text values, e.g. zh-CN, en",
      "title": "Language"
    },
    "instructions_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Version of the export instructions, copied as is",
      "title": "Instructions Version"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "depth": {
      "default": "light",
      "enum": [
        "light",
        "deep"
      ],
      "title": "Depth",
      "type": "string"
    },
    "paper": {
      "$ref": "#/$defs/Paper"
    },
    "tldr": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Tldr",
      "type": "array"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/TopicRef"
      },
      "title": "Topics",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "assets": {
      "$ref": "#/$defs/Assets"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "user_insights": {
      "items": {
        "$ref": "#/$defs/UserInsight"
      },
      "title": "User Insights",
      "type": "array"
    },
    "review_cards": {
      "items": {
        "$ref": "#/$defs/ReviewCard"
      },
      "title": "Review Cards",
      "type": "array"
    }
  },
  "required": [
    "rxf_version",
    "paper"
  ],
  "title": "RXF v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizome.local/rxf/v1.schema.json"
}

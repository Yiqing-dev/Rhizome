msgid "cli.sync_timeout"
msgstr "上传到 {host} 在 {seconds} 秒内没有完成（可在设置里给这个远程加大 \"timeout\"）。"

msgid "cli.sync_failed"
msgstr "上传到 {host} 失败（ssh 退出码 {code}）。上面的 ssh 输出说明了是哪一步出错：连接、建目录、写文件还是改名。"


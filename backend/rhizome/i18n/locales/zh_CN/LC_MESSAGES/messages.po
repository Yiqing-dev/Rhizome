msgid "rxf.yaml_error"
msgstr "YAML 无法解析：{detail}"

msgid "rxf.not_mapping"
msgstr "文档顶层必须是 YAML 映射（键: 值）。"

msgid "rxf.unknown_version"
msgstr "rxf_version 缺失或不受支持：{version}。当前支持：1。"

msgid "rxf.report_title"
msgstr "RXF 校验失败：{file}"

msgid "rxf.report_hint"
msgstr "把这份报告贴回聊天，让 AI 修正上面列出的字段后重新导出 RXF。"


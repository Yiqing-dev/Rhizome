msgid "rxf.yaml_error"
msgstr "YAML 无法解析：{detail}"

msgid "rxf.not_mapping"
msgstr "文档顶层必须是 YAML 映射（键: 值）。"

msgid "rxf.unknown_version"
msgstr "rxf_version 缺失或不受支持：{version}。当前支持：1。"

msgid "rxf.report_title"
msgstr "RXF 校验失败：{file}"

msgid "rxf.report_hint"
msgstr "把这份报告贴回聊天，让 AI 修正上面列出的字段后重新导出 RXF。"

msgid "rxf.report_summary"
msgstr "共 {problems} 处问题，归并为 {causes} 个原因："

msgid "rxf.report_count"
msgstr "（{n} 处）"

msgid "rxf.report_fix"
msgstr "修正："

msgid "rxf.report_known_ids"
msgstr "本文件声明过的 id：{ids}"

msgid "rxf.report_repairable"
msgstr "以上问题属于已知的导出偏差，可以一键修正后导入（{fixes}）：在应用里点“修正后导入”，或运行 rhz ingest --repair \"{file}\"。原文件原样保留，修正记录写入 L1。"

msgid "rxf.problem.unexpected_field"
msgstr "不允许的字段 {field}"

msgid "rxf.problem.missing_field"
msgstr "缺少必填字段 {field}"

msgid "rxf.problem.bad_reference"
msgstr "引用了本文件中不存在的 id：{values}"

msgid "rxf.problem.not_a_node"
msgstr "引用的 id 指向 issue 或复习卡，不能作为图上的节点：{values}"

msgid "rxf.problem.duplicate_id"
msgstr "id 重复：{values}"

msgid "rxf.problem.transfer"
msgstr "transfer 被摊平到了 idea 上（涉及 {values}）"

msgid "rxf.problem.bad_value"
msgstr "{field} 的取值不允许，只能是 {values}"

msgid "rxf.problem.bad_type"
msgstr "{field} 的类型不对，应为 {values}"

msgid "rxf.fix.unexpected_field"
msgstr "删除 {field}；骨架以外的字段不被接受。"

msgid "rxf.fix.missing_field"
msgstr "补上 {field}。"

msgid "rxf.fix.bad_reference"
msgstr "links_to / about 只能写本文件里已声明的 id（topics、claims、datasets、methods、ideas、user_insights 的 id），不要写名称或其他文件的 id。"

msgid "rxf.fix.not_a_node"
msgstr "改为引用 claim、method、dataset、idea、topic 或另一条 user_insight 的 id。"

msgid "rxf.fix.duplicate_id"
msgstr "每个 id 在文件内只能出现一次，给重复的条目换一个 id。"

msgid "rxf.fix.topic_new"
msgstr "删除 new；主题新不新由 Rhizome 入库时按别名判断，导出端不用标记。"

msgid "rxf.fix.transfer"
msgstr "transfer 要写成嵌套对象：transfer: {{type: cross-species, to: ..., barrier: ...}}，不要把 type / to / barrier 摊平到 idea 上。"

msgid "rxf.fix.claim_evidence"
msgstr "每条 claim 都要写原文位置，例如 evidence: Fig. 3B。"

msgid "rxf.repair.transfer_flattened"
msgstr "把摊平的 transfer 收回嵌套对象"

msgid "rxf.repair.topic_new_flag"
msgstr "删除 topics 里的 new"

msgid "card.dataset_q"
msgstr "数据集 {accession} 是什么物种 / 模态 / 组织？"

msgid "card.method_q"
msgstr "《{title}》里哪个方法做的是：{io}？"

msgid "card.user_idea_q"
msgstr "讨论《{title}》时你提出了什么想法？"

msgid "card.idea_q"
msgstr "《{title}》里有什么可迁移的思路？"

msgid "cli.ingested"
msgstr "已摄入 {file} → {work}"

msgid "cli.repaired"
msgstr "已按已知导出偏差修正后导入（{fixes}）；原文件保留在 L0，修正记录在 L1。"

msgid "cli.duplicate"
msgstr "已摄入过：{file}"

msgid "cli.failed"
msgstr "校验失败：{file}（错误报告已写入 error/）"

msgid "cli.suspect"
msgstr "疑似编造的 ID（未入库）：{ids}"

msgid "cli.related"
msgstr "与你读过的这些论文相关："

msgid "cli.no_results"
msgstr "没有结果。"

msgid "cli.serving"
msgstr "Rhizome 已在 {url} 运行"

msgid "cli.open_ui"
msgstr "打开界面：{url}"

msgid "cli.watching"
msgstr "正在监听收件箱 {path}（Ctrl+C 停止）"

msgid "cli.rebuild_done"
msgstr "重算完成：{summary}"

msgid "cli.snapshot_done"
msgstr "快照已写入 {path}"

msgid "cli.synced"
msgstr "快照已同步到 {remote}"

msgid "cli.unknown_remote"
msgstr "设置中没有名为 {name} 的远程目标。"

msgid "cli.backup_done"
msgstr "备份已写入 {path}"

msgid "cli.read_only"
msgstr "快照模式为只读。"

msgid "cli.diag_done"
msgstr "诊断包已写入 {path}（不含论文内容）"

msgid "cli.vocab_done"
msgstr "词表已写入 {path}"

msgid "cli.queue_empty"
msgstr "审核队列为空。"

msgid "cli.no_cards"
msgstr "现在没有需要复习的卡片。"

msgid "cli.card_prompt"
msgstr "评分 1=重来 2=困难 3=良好 4=简单，s=跳过，q=退出"

msgid "cli.download_hint"
msgstr "安装可选模型支持：pip install 'rhizome[models]'"

msgid "cli.job_queued"
msgstr "任务 {id} 已排队：{kind}"

msgid "cli.dataset_howto"
msgstr "下载方式"

msgid "cli.used_by"
msgstr "关联论文"

msgid "api.not_found"
msgstr "未找到"

msgid "api.unauthorized"
msgstr "令牌缺失或无效"

msgid "api.read_only"
msgstr "当前实例为只读"

msgid "dl.GEO"
msgstr "GEO：https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc={acc}（或用 GEOquery；原始数据用 prefetch 下载 SRA）"

msgid "dl.SRA"
msgstr "SRA：prefetch {acc} && fasterq-dump {acc}（https://www.ncbi.nlm.nih.gov/sra/{acc}）"

msgid "dl.ENA"
msgstr "ENA：https://www.ebi.ac.uk/ena/browser/view/{acc}"

msgid "dl.ArrayExpress"
msgstr "ArrayExpress：https://www.ebi.ac.uk/biostudies/arrayexpress/studies/{acc}"

msgid "dl.CNGB"
msgstr "CNGB：https://db.cngb.org/search/?q={acc}"

msgid "dl.other"
msgstr "检索：{acc}"

msgid "api.backup_failed"
msgstr "备份失败：{error}"

msgid "ml.unavailable"
msgstr "设置里选择的{kind}模型 {model} 在当前程序里无法加载（缺少 {module}）。安装版桌面应用只能使用内置模型：在 设置 → 本地模型 里点“改用内置模型”，然后重算；或者改用 pip 安装的 rhz serve。"

msgid "db.schema_too_new"
msgstr "这个资料库是由更新版本的 Rhizome（{version}）打开过的，数据库结构版本 {revision} 当前版本 {current} 不认识。请安装 {version} 或更新的版本；如果要回到旧版本，请用旧版本时期的备份恢复（备份在 {backups}，用 rhz restore 恢复）。资料库没有被修改。"

msgid "db.restore_missing"
msgstr "找不到备份文件：{path}"

msgid "db.restore_bad"
msgstr "备份文件不完整或已损坏，没有恢复：{path}（{error}）"

msgid "db.restore_newer"
msgstr "这份备份来自更新版本的 Rhizome（结构版本 {revision}），当前版本无法打开。"

msgid "db.restore_busy"
msgstr "资料库正在被使用。请先关闭 Rhizome 应用和 Claude Desktop（它会启动 Rhizome 的 MCP 服务），再运行恢复。"

msgid "cli.restore_confirm"
msgstr "用 {backup} 覆盖当前资料库？当前状态会先另存一份备份。"

msgid "cli.restore_done"
msgstr "已恢复。恢复前的状态保存在：{pre}"

msgid "cli.watch_app_running"
msgstr "Rhizome 应用正在运行，它已经在监听收件箱；不需要再运行 rhz watch。"

msgid "cli.restart_app_for_setting"
msgstr "{key} 已写入 settings.json；正在运行的应用要重启后才会使用它。"

msgid "api.rebuilding"
msgstr "正在重算资料库，暂时不能修改；完成后会自动恢复（通常不超过几分钟）。"

msgid "ml.index_stale"
msgstr "资料库的向量是用 {index} 生成的，当前设置的模型是 {current}。需要重算一次（设置 → 本地模型 → 立即重算，或 rhz rebuild），在此之前检索和导入会暂停。"

msgid "cli.decided"
msgstr "已记录决策 #{id}（{op}）。撤销：rhz undo {id}"

msgid "cli.undone"
msgstr "已撤销 #{id}，正在按撤销后的决策重算。"

msgid "cli.undo_noop"
msgstr "#{id} 之前已经撤销过了。"

msgid "cli.replaced"
msgstr "这份导出取代了之前的导出 {ids}（可用 rhz decisions / rhz undo 恢复）。"

msgid "cli.existing_exports"
msgstr "这篇论文已有导出 {ids}。如果这份是修正版，用 --replace 重新导入，旧导出里的错误内容才会被移除。"

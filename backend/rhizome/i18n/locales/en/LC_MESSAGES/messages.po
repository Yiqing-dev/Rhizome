msgid "api.backup_failed"
msgstr "Backup failed: {error}"

msgid "ml.unavailable"
msgstr "The {kind} model {model} chosen in settings cannot be loaded by this program ({module} is not installed). The installed desktop app runs the built-in models only: click \"Use built-in models\" in Settings → Local models and rebuild, or run the pip-installed rhz serve instead."

msgid "db.schema_too_new"
msgstr "This library was last opened by a newer Rhizome ({version}); its schema revision {revision} is unknown to {current}. Install {version} or newer, or restore a backup made with the older version (backups are in {backups}; use rhz restore). The library was not modified."

msgid "db.restore_missing"
msgstr "Backup file not found: {path}"

msgid "db.restore_bad"
msgstr "The backup is incomplete or damaged; nothing was restored: {path} ({error})"

msgid "db.restore_newer"
msgstr "This backup comes from a newer Rhizome (schema revision {revision}) and cannot be opened by this version."

msgid "db.restore_busy"
msgstr "The library is in use. Close the Rhizome app and Claude Desktop (it starts Rhizome's MCP server), then run the restore again."

msgid "cli.restore_confirm"
msgstr "Replace the current library with {backup}? The current state is backed up first."

msgid "cli.restore_done"
msgstr "Restored. The state before the restore was saved to: {pre}"

msgid "cli.watch_app_running"
msgstr "The Rhizome app is running and already watches the inbox; rhz watch is not needed."

msgid "cli.restart_app_for_setting"
msgstr "{key} was written to settings.json; the running app uses it after a restart."

msgid "api.rebuilding"
msgstr "The library is being rebuilt and cannot be changed right now; this clears by itself when the rebuild finishes (usually within minutes)."

msgid "ml.index_stale"
msgstr "The library's vectors were made with {index}, but the configured model is {current}. A rebuild is needed (Settings → Local models → Rebuild now, or rhz rebuild); searching and importing are paused until then."

msgid "cli.decided"
msgstr "Recorded decision #{id} ({op}). Undo: rhz undo {id}"

msgid "cli.undone"
msgstr "Undid #{id}; rebuilding without it."

msgid "cli.undo_noop"
msgstr "#{id} was already undone."

msgid "cli.replaced"
msgstr "This export replaces the earlier exports {ids} (restore with rhz decisions / rhz undo)."

msgid "cli.existing_exports"
msgstr "This paper already has exports {ids}. If this one is a correction, import it with --replace so what only the old exports said is removed."

msgid "api.internal_error"
msgstr "Internal error (id {id}). Details were written to the log (Settings → Storage → Logs)."

msgid "config.library_missing"
msgstr "Library not found: {path}. It may be on a disconnected drive, or the folder was renamed or moved. Reconnect the drive and try again; if the library is no longer there, run rhz data-dir --reset to go back to the default location (or delete {pointer}). Rhizome did not start, so that no empty library is created by mistake."

msgid "api.library_moved"
msgstr "The library was moved to {path}. Restart Rhizome (Settings has 'Restart now'); changes after that go to the new location."

msgid "api.move_failed"
msgstr "The move failed; the library is unchanged: {error}"

msgid "api.move_explicit_dir"
msgstr "The library location is set by RHIZOME_DATA_DIR or --data-dir ({path}); moving it here would have no effect. Change that setting instead."

msgid "api.restart_manually"
msgstr "This backend was not started by the desktop app; restart it by hand."

msgid "cli.no_library"
msgstr "No library at {path}. Import a paper first (rhz ingest FILE), or on a remote machine point rhz at a snapshot: rhz --snapshot FILE ... or export RHIZOME_SNAPSHOT=FILE"

msgid "cli.snapshot_revision"
msgstr "Snapshot schema {snapshot} (written by Rhizome {version}) differs from this program's {code} (Rhizome {current}); some commands may fail. Re-run rhz sync from the desktop, or install the same version here."

msgid "cli.snapshot_stale"
msgstr "This snapshot is {days} days old (made {created}); run rhz sync on the desktop for current results."

msgid "cli.snapshot_model"
msgstr "This snapshot was indexed with {model}, which this machine cannot load (missing: {module}); install rhizome[models] here for semantic search."

msgid "cli.sync_controlmaster_win"
msgstr "control_path (SSH ControlMaster) is not supported by Windows OpenSSH; the upload still works in one session but asks for your password / 2FA once."

msgid "cli.sync_timeout"
msgstr "Upload to {host} did not finish within {seconds} s (set a larger \"timeout\" on the remote in settings)."

msgid "cli.sync_failed"
msgstr "Upload to {host} failed (ssh exit {code}). The ssh output above says which step: connecting, creating the folder, writing the file, or renaming it."

msgid "cli.synced_hint"
msgstr "On the remote machine: export RHIZOME_SNAPSHOT={path}"

msgid "dl.SRA_run"
msgstr "SRA run: prefetch {acc} && fasterq-dump {acc}  (or FASTQ from ENA: https://www.ebi.ac.uk/ena/browser/view/{acc})"

msgid "dl.SRA_project"
msgstr "Study / project: list the runs with https://www.ebi.ac.uk/ena/portal/api/filereport?accession={acc}&result=read_run&fields=run_accession,fastq_ftp&format=tsv (download the fastq_ftp links or prefetch each run_accession); run selector: https://www.ncbi.nlm.nih.gov/Traces/study/?acc={acc}"

msgid "dl.GEO_series"
msgstr "GEO: https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc={acc}  processed files: https://ftp.ncbi.nlm.nih.gov/geo/series/{bucket}/{acc}/suppl/  (raw reads: the linked SRA study)"

msgid "cli.raw_problems"
msgstr "Raw store check: {missing} missing file(s), {empty} empty, {tmp} leftover temporary file(s); see raw in info.json"

msgid "cli.gc_done"
msgstr "Removed {pruned} unused cached vectors; the library shrank by {mb} MB."

msgid "cli.card_suspended"
msgstr "Card suspended."

msgid "card.idea_transfer_q"
msgstr "Which idea from “{title}” was proposed for {to}?"


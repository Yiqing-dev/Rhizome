msgstr "keep the list, but move it under assets: (assets: {{datasets: [...], methods: [...], ideas: [...]}})."

msgid "rxf.fix.claim_text"
msgstr "rename {field} to text (the claim's wording goes in text)."

msgid "rxf.fix.card_q"
msgstr "rename {field} to q."

msgid "rxf.fix.card_a"
msgstr "rename {field} to a."

msgid "rxf.fix.paper_venue"
msgstr "rename {field} to venue."

msgid "rxf.fix.links_to"
msgstr "rename {field} to links_to (a list of ids declared in this file)."

msgid "rxf.fix.missing_field_values"
msgstr "add {field}: one of {values}."

msgid "rxf.report_skeleton"
msgstr "Several parts are off: re-read the skeleton first (rhz rxf instructions, or the rhz_rxf_guide tool in Claude) and export again from it."

msgid "cli.rebuild_aborted"
msgstr "Rebuild stopped before changing anything: {n} stored export(s) cannot be read by this version. Fix or retract them, update Rhizome, or run again with --force to leave them out."

msgid "cli.recover_usage"
msgstr "rhz recover --from-raw   replays the raw/ folder of the current data dir into its database"

msgid "cli.recover_done"
msgstr "Recovered {recovered} capture(s); {already_present} already present; {failed} failed."

msgid "rxf.encoding"
msgstr "This file is not UTF-8 text ({detail}). Save the export as UTF-8 (in the editor: Save as → encoding UTF-8) and import it again."

msgid "cli.version_mismatch"
msgstr "The running app is Rhizome {server} but this command is {client}; results may differ until both are the same version."

msgid "api.settings_file_only"
msgstr "{field} can only be changed in settings.json or with rhz settings set (it runs commands on this computer)."

msgid "ingest.too_large"
msgstr "The {what} is too large ({mb} MB)."

msgid "ingest.not_pdf"
msgstr "The attached file is not a PDF (it does not start with %PDF); the export was not imported."

msgid "rxf.report_repairable_mcp"
msgstr "These are known export drifts ({fixes}): call rhz_ingest again with repair=true; the original text is kept and the fixes are recorded."

msgid "rxf.repair.rxf_version_type"
msgstr "read a quoted rxf_version as a number"

msgid "ml.files_missing"
msgstr "The model {model} is not downloaded yet (offline mode, or never fetched). Run: {command}"

msgid "ml.download_failed"
msgstr "Downloading {model} failed: {error}. Behind a proxy set HTTPS_PROXY; in mainland China set HF_ENDPOINT=https://hf-mirror.com and run rhz models download {model} again."

msgid "api.move_outside_profile"
msgstr "{path} is outside your user profile: the folder was created readable by this account only; check its permissions if other accounts use this computer."

msgid "db.postgres_missing"
msgstr "This build cannot open a PostgreSQL library (the psycopg driver is not included). Use the pip-installed rhizome with the postgres extra, or a SQLite library."

msgid "cli.check_raw_ok"
msgstr "Raw store: every object the database knows is present."

msgid "cli.check_backups"
msgstr "Backups: {n} in {dir} (latest {last})"

msgid "cli.export_done"
msgstr "Exported {entities} entities, {edges} edges, {decisions} decisions and {cards} cards to {path}"

